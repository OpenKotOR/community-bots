# Trask bot — production environment template
# Copy to repo-root `.env` on the VPS (merge with secrets from Developer Portal).
# See infra/trask-bot-stack/README.md

# --- Discord (required) ---
TRASK_DISCORD_APP_ID=
TRASK_DISCORD_PUBLIC_KEY=
TRASK_DISCORD_BOT_TOKEN=
TRASK_SLASH_GUILD_IDS=
TRASK_ALLOWED_GUILD_IDS=
TRASK_APPROVED_CHANNEL_IDS=

# --- Indexed research (Chroma via retrieve Worker or direct indexer) ---
# Production VPS: Worker URL or http://127.0.0.1:8790 when indexer is co-located
TRASK_INDEXER_BASE_URL=http://127.0.0.1:8787
TRASK_WEB_RESEARCH_PYTHON=.venv-trask-research/bin/python

# --- Discord → Chroma continuous sync (recommended production) ---
# 1800000 = 30 minutes. Set 0 to disable automatic sync.
TRASK_DISCORD_SYNC_INTERVAL_MS=1800000
TRASK_DISCORD_SYNC_TIMEOUT_MS=600000
# Comma-separated channel snowflakes excluded from export
TRASK_DISCORD_CHANNEL_BLACKLIST=

# --- LLM compose (OpenRouter free tier or paid OpenAI) ---
OPENROUTER_API_KEY=
TRASK_LLM_PROFILE=free

# --- State paths (defaults usually fine on VPS) ---
INGEST_STATE_DIR=data/ingest-worker
TRASK_REPO_ROOT=

# --- Optional: research logging ---
TRASK_RESEARCH_LOG_VERBOSE=0
