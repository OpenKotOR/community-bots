# ──────────────────────────────────────────────────────────────────────────────
# community-bots — unified local .env
# Copy to `.env` in the repo root and fill in all required values.
# The config package walks up from cwd so all apps share this file.
# ──────────────────────────────────────────────────────────────────────────────

# ── TRASK DISCORD BOT ─────────────────────────────────────────────────────────
TRASK_DISCORD_APP_ID=
TRASK_DISCORD_PUBLIC_KEY=
TRASK_DISCORD_BOT_TOKEN=
TRASK_DISCORD_GUILD_ID=          # optional: fast registration for a single guild
TRASK_ALLOWED_GUILD_IDS=
TRASK_APPROVED_CHANNEL_IDS=

# ── HK-86 DISCORD BOT ─────────────────────────────────────────────────────────
HK_DISCORD_APP_ID=
HK_DISCORD_PUBLIC_KEY=
HK_DISCORD_BOT_TOKEN=

# ── PAZAAK DISCORD BOT ────────────────────────────────────────────────────────
PAZAAK_DISCORD_APP_ID=
PAZAAK_DISCORD_PUBLIC_KEY=
PAZAAK_DISCORD_BOT_TOKEN=

# ── LLM / RESEARCH (optional — enables live synthesis in Trask Q&A) ───────────
# Default policy: free models first (OpenRouter :free), then paid fallbacks (auto / gpt-4o-mini).
# Set TRASK_LLM_PROFILE=paid to prefer paid models when you have OPENAI_API_KEY.
#
# Option A (recommended free): OpenRouter direct — https://openrouter.ai (free signup)
# Fallback order comes from vendor/llm_fallbacks/configs/free_models_ids.txt (bolabaden/llm_fallbacks)
# unless TRASK_REWRITE_MODEL_FALLBACKS is set.
# OPENROUTER_API_KEY=sk-or-...
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_CHAT_MODEL=openrouter/free
# TRASK_LLM_PROFILE=free
#
# Option B (recommended ops): LiteLLM proxy with free→paid fallbacks
#   Minimal: infra/trask-litellm/litellm_config.yaml
#   Full free catalog: vendor/llm_fallbacks/configs/litellm_config_free.yaml
# bash scripts/trask_litellm_proxy.sh
# OPENROUTER_API_KEY=sk-or-...
# LITELLM_PROXY_URL=http://127.0.0.1:4000
# LITELLM_API_KEY=sk-local
# TRASK_LLM_MODEL=trask-research
# TRASK_LLM_PROFILE=free
#
# Override fallback chain explicitly (comma-separated OpenRouter model ids):
# TRASK_REWRITE_MODEL_FALLBACKS=meta-llama/llama-3.3-70b-instruct:free,qwen/qwen3-coder:free,openrouter/auto
#
# Option B2: OpenCode LLM plugin (OpenAI-compatible, separate port)
# OPENCODE_LLM_PROXY_URL=http://127.0.0.1:4090
# OPENCODE_LLM_PROXY_TOKEN=
#
# Option C: OpenAI direct (paid)
# OPENAI_API_KEY=sk-...
# OPENAI_CHAT_MODEL=gpt-4o-mini
#
# Optional: python scripts/trask_print_fallback_llm.py  (vendored llm_fallbacks / LiteLLM lists)

# ── TRASK HTTP SERVER ─────────────────────────────────────────────────────────
TRASK_HTTP_PORT=4010
TRASK_WEB_ALLOW_ANONYMOUS=1
TRASK_WEB_DEFAULT_USER_ID=dev
# Crawl4AI web research (after: bash scripts/bootstrap_trask_research.sh)
# TRASK_WEB_RESEARCH_PYTHON=.venv-trask-research/bin/python
# TRASK_INDEXER_BASE_URL=http://127.0.0.1:8787
# TRASK_WEB_RESEARCH_DDG_FALLBACK=0
# TRASK_WEB_RESEARCH_LIVE_CRAWL=1
# TRASK_RESEARCH_COMPOSE_MODE=grounded
# TRASK_RESEARCHWIZARD_TIMEOUT_MS=900000

# ── PAZAAK WORLD (Vite SPA) ────────────────────────────────────────────────────
# Backend mode: "nakama" (local Nakama server) or "legacy" (HTTP bot API).
# Leave VITE_PAZAAK_BACKEND unset (or "legacy") for the bot-based HTTP flow.
# Set to "nakama" and fill VITE_NAKAMA_HOST to use the local Nakama server.
# VITE_PAZAAK_BACKEND=nakama
# VITE_NAKAMA_HOST=127.0.0.1
# VITE_NAKAMA_PORT=7350
# VITE_NAKAMA_SERVER_KEY=defaultkey

# Legacy HTTP origin — used for OAuth token exchange even when Nakama is active.
VITE_LEGACY_HTTP_ORIGIN=http://localhost:4001

# Optional comma-separated API origins (bot-based HTTP fallback chain).
# VITE_API_BASES=http://localhost:4001
